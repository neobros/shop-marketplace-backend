PORT=5000
# Frontend URL(s) allowed by CORS, comma separated (e.g. https://handmade.vercel.app)
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Firebase (Firestore is used only as the database — NOT Firebase Auth)
# Option A (Vercel): paste the whole service account JSON on one line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}

# Option B: path to the service account JSON downloaded from
#   Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Option C: individual values (use instead of the file, e.g. on a host like Render)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Default admin created by `npm run seed`
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=Admin@123
