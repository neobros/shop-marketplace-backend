PORT=5000
# Frontend URL(s) allowed by CORS, comma separated (e.g. https://ceylon-craft.vercel.app)
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MongoDB
# Atlas: Database > Connect > Drivers, e.g.
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ceylon_craft

# Google sign-in (optional) — OAuth "Web application" Client ID from Google Cloud Console
# (APIs & Services > Credentials). Use the SAME value as VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=
# true -> block email/password sign-ups; new accounts must use Google. Email LOGIN still works
# (so the admin can sign in). Pair it with VITE_GOOGLE_ONLY=true in the frontend.
GOOGLE_ONLY=false

# First trading day (YYYY-MM-DD) - demo review dates start about a week after this
BUSINESS_START=2025-12-01

# Default admin created by `npm run seed`
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=Admin@123
