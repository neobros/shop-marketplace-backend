{
  "name": "shop-marketplace-backend",
  "version": "1.0.0",
  "description": "Ceylon Craft Collective — Express + Firestore API (JWT auth)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:fresh": "node src/scripts/seed.js --fresh",
    "seed:review-dates": "node src/scripts/redate-reviews.js",
    "db:clear": "node src/scripts/clear.js",
    "db:clear:demo": "node src/scripts/clear.js --yes",
    "db:clear:all": "node src/scripts/clear.js --all --yes",
    "db:clear:all-keep-categories": "node src/scripts/clear.js --all --keep-categories --yes"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.8.0",
    "morgan": "^1.12.1"
  }
}
